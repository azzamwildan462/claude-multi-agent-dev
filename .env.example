# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# ---- Dashboard ----

# Port the local orchestration dashboard listens on. Default: 3456.
DASHBOARD_PORT=3456

# ---- Remote build & run (optional) ----
#
# These are read by the remote-execution skills (sync-to-remote, build-remote,
# run-remote, cek-remote-log) if/when they're configured to source from .env.
# Uncomment and set when you're ready to wire up the remote flow.
#
# REMOTE_HOST=10.20.30.40
# REMOTE_USER=ubuntu
